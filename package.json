{
  "name": "gyneconomy",
  "version": "528.0.0",
  "private": true,
  "description": "Gyneconomy — a single-file reading companion to the book Mrs. Market.",
  "scripts": {
    "build": "node tools/build.js",
    "build:check": "node tools/build.js --check",
    "setup": "playwright install chromium",
    "test": "node test/gyn-test.js index.html",
    "test:full": "node test/gyn-test.js index.html --full",
    "bless": "node test/gyn-test.js index.html --bless",
    "css": "node tools/css-count.js index.html",
    "email": "test \"$(grep -cE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}' index.html)\" = 0 && echo 'ok: no email address in markup'",
    "map": "python3 tools/make-map.py",
    "map:check": "python3 tools/make-map.py --check",
    "snap": "node tools/snapshot.js index.html snap.json",
    "snap:diff": "node tools/snapshot.js",
    "classify": "node tools/classify.js index.html",
    "sources": "node tools/gen-sources.js",
    "sources:check": "node tools/gen-sources.js --check"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
